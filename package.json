{
  "name": "nexus-rag",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "client:dev": "vite",
    "server:dev": "nodemon",
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "check": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "tsx api/server.ts"
  },
  "dependencies": {
    "@vueuse/core": "^11.0.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "highlight.js": "^11.12.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-vue-next": "^0.511.0",
    "mammoth": "^1.8.0",
    "markdown-it": "^14.1.0",
    "marked": "^14.1.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.67.3",
    "pdf-parse": "^1.1.1",
    "pinia": "^2.2.4",
    "tailwind-merge": "^3.3.0",
    "uuid": "^10.0.0",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5",
    "zod": "^3.23.8"
