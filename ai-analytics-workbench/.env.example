# ========== 数据库 ==========
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics123
POSTGRES_DB=analytics_workbench
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# 数据库 URL（供后端使用）
DATABASE_URL=postgresql+psycopg://analytics:analytics123@postgres:5432/analytics_workbench

# ========== Redis ==========
REDIS_HOST=redis
REDIS_PORT=6379
# 与 docker-compose.yml 中 redis 的 requirepass 保持一致
REDIS_PASSWORD=redis123
CELERY_BROKER_URL=redis://:redis123@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis123@redis:6379/1

# ========== LLM ==========
# 支持 openai / deepseek / 通义千问等 OpenAI 兼容接口
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ========== 应用 ==========
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 演示账号是否授予管理员权限（默认 false，降权；仅演示环境显式开启）
DEMO_ALLOW_ADMIN=false

# 上传限制
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
