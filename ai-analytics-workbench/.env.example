# ========== 数据库 ==========
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics123
POSTGRES_DB=analytics_workbench
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# 数据库 URL（供后端使用）
DATABASE_URL=postgresql+psycopg://analytics:analytics123@postgres:5432/analytics_workbench

# ========== Redis ==========
REDIS_HOST=redis
REDIS_PORT=6379
# 与 docker-compose.yml 中 redis 的 requirepass 保持一致
REDIS_PASSWORD=redis123
CELERY_BROKER_URL=redis://:redis123@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis123@redis:6379/1

# ========== LLM ==========
# 支持 openai / deepseek / 通义千问等 OpenAI 兼容接口
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ========== 应用 ==========
APP_ENV=development
# 生产环境保持 false：开发态回显 SQL 会把参数值写进日志
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT（access 默认 12h；refresh 默认 7d，用于 /auth/refresh 换取新 token 对）
JWT_EXPIRE_MINUTES=720
JWT_REFRESH_EXPIRE_MINUTES=10080

# 演示账号是否授予管理员权限（默认 false，降权；仅演示环境显式开启）
DEMO_ALLOW_ADMIN=false

# 上传限制
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# 报告/图表工件目录（API 进程与 Celery worker 必须指向同一路径）
REPORTS_DIR=./reports
# 图表保留天数：应用启动时清理过期 chart_*.png；0 表示禁用清理
CHART_RETENTION_DAYS=30

# 沙箱（subprocess=子进程隔离，默认；docker=容器级隔离，需 Docker 引擎）
SANDBOX_MODE=subprocess
# docker 模式镜像；本地缺失自动 pull，失败回退 subprocess
SANDBOX_DOCKER_IMAGE=python:3.12-alpine
